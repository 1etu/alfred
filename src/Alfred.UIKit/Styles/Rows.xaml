<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Alfred.UIKit;component/Styles/Typography.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="PageRoot" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="PageBody" TargetType="StackPanel">
    <Setter Property="Margin" Value="44,10,44,32" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MaxWidth" Value="980" />
  </Style>

  <Style x:Key="BigTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontDisplay}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="RowSub" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontSmall}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontDisplay}" />
    <Setter Property="FontSize" Value="{StaticResource PageTitleSize}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>

  <Style x:Key="DayHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontSmall}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Margin" Value="12,30,0,8" />
  </Style>

  <Style x:Key="SectionRule" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Hairline}" />
    <Setter Property="Margin" Value="12,0,12,10" />
  </Style>

  <Style x:Key="ItemRow" TargetType="Border">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,5,10,5" />
    <Setter Property="MinHeight" Value="42" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource SheetHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="RowTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="{StaticResource RowFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="RowMeta" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontSmall}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="RowAmount" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontSmall}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource SegmentTrack}" />
    <Setter Property="Padding" Value="9,3,9,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CardSurface" TargetType="Border">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
  </Style>

</ResourceDictionary>
