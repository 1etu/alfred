<UserControl x:Class="Alfred.UIKit.Controls.DayStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls">
  <ItemsControl x:Name="Days">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type controls:DayStripDay}">
        <RadioButton GroupName="DayStrip"
                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                     Focusable="True"
                     Cursor="Hand"
                     AutomationProperties.Name="{Binding Date}">
          <RadioButton.Template>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Chip"
                      CornerRadius="9"
                      Width="46"
                      Height="54"
                      Margin="0,0,7,0"
                      Background="Transparent">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}"
                             HorizontalAlignment="Center"
                             FontFamily="{StaticResource AppFontSmall}"
                             FontSize="10.5"
                             Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Text="{Binding Number}"
                             HorizontalAlignment="Center"
                             Margin="0,2,0,0"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SidebarRowHover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SidebarRowSelected}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SidebarRowHover}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </RadioButton.Template>
        </RadioButton>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
