<UserControl x:Class="Alfred.UIKit.Controls.ShortcutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Cursor="Hand">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

    <TextBlock x:Name="ConflictText"
               Text="{Binding Conflict, RelativeSource={RelativeSource AncestorType=UserControl}}"
               VerticalAlignment="Center"
               Margin="0,0,10,0"
               FontFamily="{StaticResource AppFontSmall}"
               FontSize="11"
               Foreground="{DynamicResource WindowButtonClose}"
               Visibility="Collapsed" />

    <Border x:Name="Surface" CornerRadius="7" Padding="3" Background="Transparent">
      <StackPanel Orientation="Horizontal">

        <TextBlock x:Name="Prompt"
                   Text="{DynamicResource Loc.Shortcut.Prompt}"
                   Margin="6,0,6,0"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource AppFontSmall}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondary}"
                   Visibility="Collapsed" />

        <ItemsControl ItemsSource="{Binding Caps, RelativeSource={RelativeSource AncestorType=UserControl}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource KeyCap}" Margin="2,0,2,0">
                <TextBlock Text="{Binding}" Style="{StaticResource KeyCapText}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
