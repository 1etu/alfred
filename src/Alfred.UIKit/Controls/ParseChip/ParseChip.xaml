<UserControl x:Class="Alfred.UIKit.Controls.ParseChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
  <Border CornerRadius="7"
          Background="{DynamicResource AccentSoft}"
          Padding="9,3,4,4"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">

      <TextBlock x:Name="LabelText"
                 Text="{Binding Label, ElementName=Root}"
                 Margin="0,1,5,0"
                 VerticalAlignment="Center"
                 FontFamily="{StaticResource AppFontSmall}"
                 FontSize="10.5"
                 FontWeight="SemiBold"
                 Opacity="0.72"
                 Foreground="{DynamicResource Accent}" />

      <TextBlock Text="{Binding Value, ElementName=Root}"
                 VerticalAlignment="Center"
                 FontFamily="{StaticResource AppFontSmall}"
                 FontSize="11.5"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Accent}" />

      <Button Width="18"
              Height="18"
              Margin="3,0,0,0"
              Cursor="Hand"
              ToolTip="{DynamicResource Loc.Chip.Remove}"
              AutomationProperties.Name="{DynamicResource Loc.Chip.Remove}"
              Click="OnDismiss">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Path x:Name="Cross"
                    Data="M0,0 L6,6 M6,0 L0,6"
                    Stroke="{DynamicResource Accent}"
                    StrokeThickness="1.4"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Opacity="0.55"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Cross" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>

    </StackPanel>
  </Border>
</UserControl>
