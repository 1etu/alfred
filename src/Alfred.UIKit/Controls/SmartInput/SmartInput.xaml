<UserControl x:Class="Alfred.UIKit.Controls.SmartInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suggest="clr-namespace:Alfred.UIKit.Suggest">
  <Border CornerRadius="8" Background="{DynamicResource SegmentTrack}" ClipToBounds="True">
    <StackPanel>
      <Grid>
        <TextBlock x:Name="PlaceholderText"
                   Margin="11,0,11,0"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource AppFont}"
                   FontSize="{StaticResource BodyFontSize}"
                   Foreground="{DynamicResource TextSecondary}"
                   Opacity="0.7"
                   IsHitTestVisible="False" />
        <TextBox x:Name="Input"
                 Margin="8,0,8,0"
                 Padding="3,8,3,8"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="{StaticResource AppFont}"
                 FontSize="{StaticResource BodyFontSize}"
                 Foreground="{DynamicResource TextPrimary}"
                 CaretBrush="{DynamicResource TextPrimary}"
                 AutomationProperties.Name="Smart input"
                 TextChanged="OnTextChanged"
                 PreviewKeyDown="OnInputKeyDown"
                 LostKeyboardFocus="OnInputLostFocus" />
      </Grid>

      <ListBox x:Name="List"
               Background="Transparent"
               BorderThickness="0"
               Margin="4,0,4,0"
               MaxHeight="0"
               Focusable="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Hidden"
               PreviewMouseLeftButtonUp="OnListClick">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Primary}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Pill" Background="Transparent" CornerRadius="6" Height="34">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SidebarRowHover}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SidebarRowSelected}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type suggest:Suggestion}">
            <Grid Margin="7,0,9,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border x:Name="Tile"
                      Grid.Column="0"
                      Width="22"
                      Height="22"
                      CornerRadius="5"
                      Margin="0,0,9,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource CardBackground}"
                      Visibility="Collapsed">
                <Image Source="{Binding BrandSlug, Converter={StaticResource BrandTileImage}}"
                       Width="13"
                       Height="13" />
              </Border>

              <TextBlock Grid.Column="1"
                         Text="{Binding Primary}"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="{StaticResource BodyFontSize}"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimary}"
                         TextTrimming="CharacterEllipsis" />

              <TextBlock Grid.Column="2"
                         Text="{Binding Secondary}"
                         VerticalAlignment="Center"
                         Margin="12,0,0,0"
                         FontFamily="{StaticResource AppFontSmall}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondary}" />
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding BrandSlug, Converter={StaticResource IsNotNull}}" Value="True">
                <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Border>
</UserControl>
