<UserControl x:Class="Alfred.UIKit.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ListBox Style="{StaticResource SidebarList}"
           ItemsSource="{Binding Items}"
           SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
           ItemTemplate="{StaticResource SidebarRowContent}"
           Margin="{StaticResource SidebarInset}">
    <ListBox.GroupStyle>
      <GroupStyle ContainerStyle="{StaticResource SidebarGroup}" />
    </ListBox.GroupStyle>
  </ListBox>
</UserControl>
