<UserControl x:Class="Alfred.UIKit.Controls.ActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls"
             x:Name="Root"
             Focusable="False">
  <Border Height="44"
          Background="{DynamicResource SheetBackground}"
          BorderBrush="{DynamicResource Hairline}"
          BorderThickness="0,1,0,0">
    <ItemsControl ItemsSource="{Binding Items, ElementName=Root}"
                  VerticalAlignment="Center"
                  Margin="24,0,24,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type controls:ActionBarItem}">
          <Button Width="32"
                  Height="32"
                  HorizontalAlignment="Center"
                  Cursor="Hand"
                  ToolTip="{Binding Name}"
                  AutomationProperties.Name="{Binding Name}"
                  Click="OnItemClick">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Pill" CornerRadius="8" Background="Transparent">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SheetHover}" />
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SheetHover}" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SidebarRowHover}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path Data="{Binding GlyphKey, Converter={StaticResource GlyphLookup}}">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProminent}" Value="True">
                          <Setter Property="Fill" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Canvas>
            </Viewbox>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>
