<UserControl x:Class="Alfred.UIKit.Controls.FolderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Button Click="OnOpen"
          Cursor="Hand"
          AutomationProperties.Name="{Binding Title, ElementName=Root}"
          MouseEnter="OnPointerEnter"
          MouseLeave="OnPointerLeave">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Border x:Name="Surface"
                CornerRadius="12"
                Background="Transparent"
                Padding="18,16,18,14">
          <ContentPresenter />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SheetHover}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SheetHover}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Button.Template>

    <StackPanel>
      <Grid Width="96" Height="78" ClipToBounds="False">

        <Border Width="30"
                Height="14"
                CornerRadius="5,5,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="6,8,0,0"
                Background="{Binding TintBrush, ElementName=Root}"
                Opacity="0.55" />

        <Border Width="84"
                Height="56"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{Binding TintBrush, ElementName=Root}"
                Opacity="0.4" />

        <StackPanel x:Name="Peek"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20" />

        <Border Width="84"
                Height="36"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{Binding TintBrush, ElementName=Root}"
                RenderTransformOrigin="0.5,1">
          <Border.RenderTransform>
            <ScaleTransform x:Name="PocketScale" ScaleX="1" ScaleY="1" />
          </Border.RenderTransform>
        </Border>
      </Grid>

      <TextBlock Text="{Binding Title, ElementName=Root}"
                 Margin="0,10,0,0"
                 HorizontalAlignment="Center"
                 FontFamily="{StaticResource AppFont}"
                 FontSize="12.5"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimary}" />

      <TextBlock x:Name="CountText"
                 Margin="0,2,0,0"
                 HorizontalAlignment="Center"
                 FontFamily="{StaticResource AppFontSmall}"
                 FontSize="11"
                 Foreground="{DynamicResource TextSecondary}" />
    </StackPanel>
  </Button>
</UserControl>
