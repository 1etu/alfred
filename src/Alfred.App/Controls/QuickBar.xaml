<UserControl x:Class="Alfred.App.Controls.QuickBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suggest="clr-namespace:Alfred.App.Suggest">
  <Border CornerRadius="10" Background="{DynamicResource SheetHover}" ClipToBounds="True">
    <StackPanel>
      <Grid Margin="14,0,14,0" MinHeight="38">
        <TextBlock x:Name="TitleGhost"
                   VerticalAlignment="Center"
                   Margin="1,0,0,0"
                   FontFamily="{StaticResource AppFont}"
                   FontSize="{StaticResource BodyFontSize}"
                   Foreground="{DynamicResource TextSecondary}"
                   Opacity="0.6"
                   IsHitTestVisible="False" />
        <TextBox x:Name="TitleField"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,9,0,10"
                 FontFamily="{StaticResource AppFont}"
                 FontSize="{StaticResource BodyFontSize}"
                 Foreground="{DynamicResource TextPrimary}"
                 CaretBrush="{DynamicResource Accent}"
                 VerticalContentAlignment="Center"
                 AutomationProperties.Name="Quick add"
                 TextChanged="OnTitleChanged"
                 PreviewKeyDown="OnFieldKeyDown" />
        <Border x:Name="DateBadge"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                CornerRadius="7"
                Background="{DynamicResource AccentSoft}"
                Padding="9,3,9,4"
                Visibility="Collapsed">
          <TextBlock x:Name="DateBadgeText"
                     FontFamily="{StaticResource AppFontSmall}" FontSize="11.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource Accent}" />
        </Border>
      </Grid>

      <ListBox x:Name="List"
               Background="Transparent"
               BorderThickness="0"
               Margin="6,0,6,0"
               MaxHeight="0"
               Focusable="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Hidden"
               PreviewMouseLeftButtonUp="OnListClick">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Primary}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Pill" Background="Transparent" CornerRadius="8" Height="36">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SidebarRowHover}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoft}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type suggest:Suggestion}">
            <Grid Margin="9,0,11,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                      Margin="0,0,9,0" VerticalAlignment="Center"
                      Background="{DynamicResource SheetBackground}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding BrandSlug}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Image Source="{Binding BrandSlug, Converter={StaticResource BrandTileImage}}" Width="13" Height="13" />
              </Border>

              <TextBlock Grid.Column="1" Text="{Binding Primary}" VerticalAlignment="Center"
                         FontFamily="{StaticResource AppFont}" FontSize="{StaticResource BodyFontSize}"
                         FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />

              <TextBlock Grid.Column="2" Text="{Binding Secondary}" VerticalAlignment="Center" Margin="16,0,0,0"
                         FontFamily="{StaticResource AppFontSmall}" FontSize="12"
                         Foreground="{DynamicResource TextSecondary}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Border>
</UserControl>
