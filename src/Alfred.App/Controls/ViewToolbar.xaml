<UserControl x:Class="Alfred.App.Controls.ViewToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Border x:Name="Shell"
          CornerRadius="11"
          Background="{DynamicResource ToolbarBackground}"
          BorderBrush="{DynamicResource Hairline}"
          BorderThickness="1"
          Padding="5"
          Opacity="0.55">
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.22" BeginTime="0:0:0.3">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>
        </Style.Triggers>
      </Style>
    </Border.Style>

    <ItemsControl ItemsSource="{Binding Actions, ElementName=Root}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Width="30" Height="30" Margin="1,0,1,0"
                  Focusable="False" Cursor="Hand"
                  ToolTip="{Binding Name}"
                  AutomationProperties.Name="{Binding Name}"
                  Click="OnActionClick">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Pill" CornerRadius="8" Background="Transparent">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SidebarRowSelected}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path Data="{Binding GlyphKey, Converter={StaticResource GlyphLookup}}"
                      Fill="{DynamicResource ChromeGlyph}" />
              </Canvas>
            </Viewbox>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>
