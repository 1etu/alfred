<UserControl x:Class="Alfred.App.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.App.Controls">
  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">

      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,10,0,0" />

      <controls:SmartInput x:Name="QuickTitle"
                           Margin="0,30,0,0"
                           Width="620"
                           HorizontalAlignment="Left"
                           Placeholder="Add something for today…"
                           Submitted="OnQuickAdd"
                           Visibility="{Binding IsToday, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />

      <ItemsControl ItemsSource="{Binding Rows}" Margin="0,22,0,0" />

      <StackPanel HorizontalAlignment="Center"
                  Margin="0,120,0,0"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <Image Source="{StaticResource AlfredCryingIcon}" Width="80" Height="80" Opacity="0.4" />
        <TextBlock Text="All clear. Alfred approves."
                   Margin="0,18,0,0"
                   HorizontalAlignment="Center"
                   FontFamily="{StaticResource AppFont}"
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
