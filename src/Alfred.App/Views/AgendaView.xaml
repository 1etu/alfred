<UserControl x:Class="Alfred.App.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.App.Controls">
  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="4,0,0,20" />

      <Grid Visibility="{Binding IsToday, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
            Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="130" />
        </Grid.ColumnDefinitions>
        <controls:SmartInput x:Name="QuickTitle"
                             Grid.Column="0"
                             Placeholder="Add something for today…"
                             Submitted="OnQuickAdd" />
        <controls:SmartInput x:Name="QuickDate"
                             Grid.Column="1"
                             Margin="8,0,0,0"
                             Placeholder="When"
                             VerticalAlignment="Top" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Rows}" />

      <StackPanel HorizontalAlignment="Center"
                  Margin="0,64,0,0"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <Image Source="{StaticResource AlfredCryingIcon}" Width="64" Height="64" Opacity="0.5" />
        <TextBlock Text="All clear. Alfred approves."
                   Margin="0,14,0,0"
                   HorizontalAlignment="Center"
                   FontFamily="{StaticResource AppFontSmall}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
