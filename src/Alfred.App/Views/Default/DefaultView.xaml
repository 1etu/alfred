<UserControl x:Class="Alfred.App.Views.DefaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls;assembly=Alfred.UIKit">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="44,54,44,0">
      <Image Source="{Binding Icon}"
             Width="24"
             Height="24"
             Margin="0,3,10,0"
             VerticalAlignment="Center" />
      <TextBlock Text="{Binding Title}" Style="{StaticResource BigTitle}" />
    </StackPanel>

    <controls:EmptyState Grid.Row="1" Label="{Binding Title}" />
  </Grid>
</UserControl>
