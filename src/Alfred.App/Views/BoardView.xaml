<UserControl x:Class="Alfred.App.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.App.Controls">
  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Margin="48,40,48,56" HorizontalAlignment="Left">
      <TextBlock Text="Free Board" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Drag postits between columns" Style="{StaticResource PageSubtitle}" Margin="4,0,0,20" />

      <ItemsControl ItemsSource="{Binding Columns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="228"
                    Margin="0,0,14,0"
                    CornerRadius="10"
                    Background="{DynamicResource CardBackground}"
                    Padding="10"
                    AllowDrop="True"
                    Drop="OnDrop"
                    DragOver="OnDragOver">
              <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontFamily="{StaticResource AppFontSmall}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="4,0,0,10" />

                <ItemsControl ItemsSource="{Binding Cards}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Card"
                              CornerRadius="7"
                              Padding="10,9,10,10"
                              Margin="0,0,0,7"
                              Cursor="Hand"
                              MouseMove="OnCardMouseMove">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFD64A" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Tint}" Value="1">
                                <Setter Property="Background" Value="#FF9EC1" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Tint}" Value="2">
                                <Setter Property="Background" Value="#7EDCE8" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Tint}" Value="3">
                                <Setter Property="Background" Value="#93D97C" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Tint}" Value="4">
                                <Setter Property="Background" Value="#C9AEFF" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Title}"
                                     FontFamily="{StaticResource AppFont}"
                                     FontSize="12.5"
                                     FontWeight="Medium"
                                     Foreground="#2B2B26"
                                     TextWrapping="Wrap" />
                          <Button Grid.Column="1" Click="OnRemoveCard" Width="18" Height="18"
                                  VerticalAlignment="Top" Margin="6,0,0,0" Focusable="False" Cursor="Hand">
                            <Button.Style>
                              <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Template">
                                  <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                      <Grid Background="Transparent">
                                        <TextBlock Text="×" FontSize="13" FontWeight="SemiBold" Foreground="#66000000"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      </Grid>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:SmartInput Placeholder="Add a postit…" Submitted="OnAddCard" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
