<UserControl x:Class="Alfred.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls;assembly=Alfred.UIKit">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="44,44,44,72">
      <TextBlock Text="Settings" Style="{StaticResource BigTitle}" Margin="0,0,0,20" />

      <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionTitle}" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>

          <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Theme" Style="{StaticResource SettingsRowLabel}" />
            <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" Content="System" GroupName="Theme"
                             IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Segment}" Content="Light" GroupName="Theme"
                             IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Segment}" Content="Dark" GroupName="Theme"
                             IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Style="{StaticResource SettingsDivider}" />

          <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,12,24,12">
              <TextBlock Text="Glass sidebar" Style="{StaticResource SettingsRowLabel}" />
              <TextBlock Text="Native acrylic behind the sidebar. Softens text edges slightly."
                         Style="{StaticResource SettingsRowCaption}" />
            </StackPanel>
            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsGlassEnabled, Mode=TwoWay}" />
          </Grid>

        </StackPanel>
      </Border>

      <TextBlock Text="Sidebar" Style="{StaticResource SettingsSectionTitle}" Margin="4,30,0,10" />
      <Border Style="{StaticResource SettingsCard}">
        <Grid Style="{StaticResource SettingsRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Show counts" Style="{StaticResource SettingsRowLabel}" />
          <ToggleButton Grid.Column="1"
                        Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ShowCounts, Mode=TwoWay}" />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Shortcuts.Registered.Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,30,0,0">
              <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsSectionTitle}" />
              <Border Style="{StaticResource SettingsCard}">
                <ItemsControl ItemsSource="{Binding Items}" AlternationCount="99">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <Border x:Name="Divider" Style="{StaticResource SettingsDivider}" />
                        <Grid Style="{StaticResource SettingsRow}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0"
                                     Text="{Binding Name}"
                                     Style="{StaticResource SettingsRowLabel}" />
                          <controls:ShortcutEditor Grid.Column="1"
                                                   Margin="24,0,0,0"
                                                   Shortcut="{Binding}"
                                                   Registry="{Binding DataContext.Shortcuts, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Grid>
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                          <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Microsoft account" Style="{StaticResource SettingsSectionTitle}" Margin="4,30,0,10" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,12,24,12">
              <TextBlock Text="Calendar sync" Style="{StaticResource SettingsRowLabel}" />
              <TextBlock Text="Pushes the next 90 days into an 'Alfred' calendar. Needs your own Azure app registration — press Get one, then paste the Application (client) ID below."
                         Style="{StaticResource SettingsRowCaption}" />
              <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource SettingsRowCaption}" Foreground="{DynamicResource MoneyIn}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding AccountLabel}" Style="{StaticResource SettingsValue}" Margin="0,0,14,0" />
              <Button Style="{StaticResource GhostButton}" Click="OnConnect" IsEnabled="{Binding CanConnect}">
                <TextBlock Text="{Binding ConnectLabel}" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
              </Button>
              <Button Style="{StaticResource GhostButton}" Click="OnSyncNow" Margin="4,0,0,0"
                      IsEnabled="{Binding IsSignedIn}">
                <TextBlock Text="Sync now" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
              </Button>
            </StackPanel>
          </Grid>

          <Border Style="{StaticResource SettingsDivider}" />

          <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,12,0,12">
              <TextBlock Text="ClientId" Style="{StaticResource SettingsRowLabel}" />
              <TextBlock Text="{Binding ClientIdHint}" Style="{StaticResource SettingsRowCaption}" />
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource SegmentTrack}" Margin="20,12,12,12">
              <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=LostFocus}"
                       Margin="10,0,10,0" Padding="3,7,3,7"
                       Background="Transparent" BorderThickness="0"
                       FontFamily="{StaticResource AppFontSmall}" FontSize="12"
                       Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" />
            </Border>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="OnOpenPortal">
              <TextBlock Text="Get one" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="Updates" Style="{StaticResource SettingsSectionTitle}" Margin="4,30,0,10" />
      <Border Style="{StaticResource SettingsCard}">
        <Grid Style="{StaticResource SettingsRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,12,24,12">
            <TextBlock Text="Software update" Style="{StaticResource SettingsRowLabel}" />
            <TextBlock Text="{Binding Updates.Message}" Style="{StaticResource SettingsRowCaption}" />
            <ProgressBar Height="3" Margin="0,8,0,0" Maximum="1"
                         Value="{Binding Updates.Progress, Mode=OneWay}"
                         Background="{DynamicResource SegmentTrack}"
                         Foreground="{DynamicResource Accent}"
                         BorderThickness="0">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Updates.State}" Value="Downloading">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource GhostButton}" Click="OnCheckUpdates">
              <TextBlock Text="Check" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}" />
            </Button>
            <Button Click="OnDownloadUpdate" Margin="4,0,0,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Updates.State}" Value="Available">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock Text="Download" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource Accent}" />
            </Button>
            <Button Click="OnInstallUpdate" Margin="4,0,0,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Updates.State}" Value="Ready">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock Text="Install and restart" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource Accent}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="About" Style="{StaticResource SettingsSectionTitle}" Margin="4,30,0,10" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>

          <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Version" Style="{StaticResource SettingsRowLabel}" />
            <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource SettingsValue}" />
          </Grid>

          <Border Style="{StaticResource SettingsDivider}" />

          <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Preferences" Style="{StaticResource SettingsRowLabel}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding PreferencesPath}"
                       Style="{StaticResource SettingsValue}"
                       HorizontalAlignment="Right"
                       Margin="24,0,0,0"
                       TextTrimming="CharacterEllipsis" />
          </Grid>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
