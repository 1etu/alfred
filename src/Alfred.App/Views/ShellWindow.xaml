<Window x:Class="Alfred.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Alfred.App.Controls"
        xmlns:views="clr-namespace:Alfred.App.Views"
        Title="Alfred"
        Icon="/Resources/Alfred.ico"
        Width="1100"
        Height="700"
        MinWidth="720"
        MinHeight="480"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource BodyFontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="{StaticResource TitleBarHeight}"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate x:Key="PlaceholderTemplate">
      <views:PlaceholderView />
    </DataTemplate>
    <DataTemplate x:Key="SettingsTemplate">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" ClipToBounds="True">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="{StaticResource SidebarWidth}" />
          <Setter Property="Background" Value="{DynamicResource SidebarBackground}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Settings.IsGlassEnabled}" Value="True">
              <Setter Property="Background" Value="{DynamicResource SidebarBackgroundGlass}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                     To="{StaticResource SidebarWidth}"
                                     Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <Grid Width="{StaticResource SidebarWidth}" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Height="{StaticResource TitleBarHeight}" />
        <controls:Sidebar Grid.Row="1" />
      </Grid>
    </Border>

    <Border Grid.Column="1"
            BorderBrush="{DynamicResource Hairline}"
            BorderThickness="1,0,0,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource ShellBackground}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Settings.IsGlassEnabled}" Value="True">
              <Setter Property="Background" Value="{DynamicResource ShellBackgroundGlass}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <ContentControl Content="{Binding}" Margin="0,44,0,0">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource PlaceholderTemplate}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </Border>

    <StackPanel Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Height="{StaticResource TitleBarHeight}"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="20,0,0,0">

      <controls:WindowButtons VerticalAlignment="Center" />

      <Button Style="{StaticResource ChromeButton}"
              Margin="18,0,0,0"
              VerticalAlignment="Center"
              ToolTip="Toggle sidebar"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Click="OnToggleSidebarClick">
        <Path Data="{StaticResource SidebarGlyph}"
              Fill="{DynamicResource ChromeGlyph}"
              Width="17"
              Height="17"
              Stretch="Uniform" />
      </Button>

    </StackPanel>

  </Grid>
</Window>
