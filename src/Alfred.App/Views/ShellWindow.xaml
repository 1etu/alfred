<Window x:Class="Alfred.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Alfred.App.Controls"
        xmlns:views="clr-namespace:Alfred.App.Views"
        xmlns:vm="clr-namespace:Alfred.App.ViewModels"
        Title="Alfred"
        Icon="/Resources/Alfred.ico"
        Width="1100"
        Height="700"
        MinWidth="720"
        MinHeight="480"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource BodyFontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="{StaticResource TitleBarHeight}"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:AgendaViewModel}">
      <views:AgendaView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PaymentsViewModel}">
      <views:PaymentsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TodosViewModel}">
      <views:TodosView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RemindersViewModel}">
      <views:RemindersView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlansViewModel}">
      <views:PlansView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BoardViewModel}">
      <views:BoardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MealsViewModel}">
      <views:MealsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WishesViewModel}">
      <views:WishesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
      <views:CalendarView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TrashViewModel}">
      <views:TrashView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" ClipToBounds="True">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="{StaticResource SidebarWidth}" />
          <Setter Property="Background" Value="{DynamicResource SidebarBackground}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Settings.IsGlassEnabled}" Value="True">
              <Setter Property="Background" Value="{DynamicResource SidebarBackgroundGlass}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                     To="{StaticResource SidebarWidth}"
                                     Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <Grid Width="{StaticResource SidebarWidth}" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Height="{StaticResource TitleBarHeight}" />
        <controls:Sidebar Grid.Row="1" />
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Background="{DynamicResource ShellBackground}"
            BorderBrush="{DynamicResource Hairline}"
            BorderThickness="1,0,0,0">
      <Grid>
        <ContentControl Content="{Binding CurrentContent}"
                        Margin="0,44,0,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <controls:ViewToolbar Actions="{Binding ToolbarActions}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,56,44,0"
                              Visibility="{Binding HasToolbar, Converter={StaticResource BoolToVisibility}}" />

        <Button x:Name="MagicPlus"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="56,0,0,40"
                Width="52"
                Height="52"
                Focusable="False"
                Cursor="Hand"
                ToolTip="{Binding PrimaryActionName}"
                AutomationProperties.Name="{Binding PrimaryActionName}"
                Visibility="{Binding HasPrimaryAction, Converter={StaticResource BoolToVisibility}}"
                Click="OnMagicPlus">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid x:Name="PlusRoot" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Ellipse Fill="{DynamicResource Accent}" />
                <Viewbox Width="22" Height="22">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource PlusGlyph}" Fill="#FFFFFF" />
                  </Canvas>
                </Viewbox>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="PlusRoot"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1.08" Duration="0:0:0.14">
                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="PlusRoot"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1.08" Duration="0:0:0.14">
                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="PlusRoot"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="PlusRoot"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1" Duration="0:0:0.12" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Column="0"
          Grid.ColumnSpan="2"
          Height="{StaticResource TitleBarHeight}"
          VerticalAlignment="Top">

      <controls:WindowButtons HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="20,0,0,0" />

      <Button VerticalAlignment="Center"
              HorizontalAlignment="Left"
              ToolTip="Toggle sidebar"
              AutomationProperties.Name="Toggle sidebar"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Click="OnToggleSidebarClick">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Margin" Value="{StaticResource SidebarToggleExpanded}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                <Setter Property="Margin" Value="{StaticResource SidebarToggleCollapsed}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <Viewbox Width="18" Height="18">
          <Canvas Width="24" Height="24">
            <Path Data="{StaticResource SidebarGlyph}" Fill="{DynamicResource ChromeGlyph}" />
          </Canvas>
        </Viewbox>
      </Button>

    </Grid>

  </Grid>
</Window>
