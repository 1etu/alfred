<UserControl x:Class="Alfred.App.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls;assembly=Alfred.UIKit">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">
      <StackPanel Orientation="Horizontal" Margin="0,44,0,14">
        <Image Source="{StaticResource RemindersIcon}" Width="24" Height="24" Margin="0,3,10,0" VerticalAlignment="Center" />
        <TextBlock Text="Reminders" Style="{StaticResource BigTitle}" />
      </StackPanel>

      <controls:QuickBar x:Name="Bar"
                         Margin="0,0,0,22"
                         TitlePlaceholder="Remind me to…"
                         Submitted="OnQuickAdd" />

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Row" Style="{StaticResource ItemRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0" Style="{StaticResource CheckCircle}" HorizontalAlignment="Left"
                              IsChecked="{Binding IsDone, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="{Binding Meta}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource RowMeta}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Overdue}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="3" Margin="8,0,0,0" Click="OnRemoveRow">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                      <Setter Property="Opacity" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                          <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <Viewbox Width="13" Height="13">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource TrashGlyph}" Fill="{DynamicResource TextSecondary}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel HorizontalAlignment="Center" Margin="0,120,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <Image Source="{StaticResource AlfredCryingIcon}" Width="80" Height="80" Opacity="0.4" />
        <TextBlock Text="Nothing to remember. Lucky you."
                   Margin="0,14,0,0" HorizontalAlignment="Center"
                   FontFamily="{StaticResource AppFont}" FontSize="14"
                   Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
