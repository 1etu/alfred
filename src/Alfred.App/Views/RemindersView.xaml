<UserControl x:Class="Alfred.App.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.App.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">
      <TextBlock Text="Reminders" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Alfred will keep them on your Today" Style="{StaticResource PageSubtitle}" Margin="0,10,0,28" />

      <Grid Margin="0,0,0,20" MaxWidth="760" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="84" />
        </Grid.ColumnDefinitions>
        <controls:SmartInput x:Name="QuickTitle" Grid.Column="0" Placeholder="Remind me to…" Submitted="OnQuickAdd" />
        <controls:SmartInput x:Name="QuickDate" Grid.Column="1" Margin="8,0,0,0" Placeholder="When" VerticalAlignment="Top" />
        <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource SegmentTrack}" Margin="8,0,0,0" VerticalAlignment="Top">
          <TextBox x:Name="QuickTime"
                   Margin="8,0,8,0" Padding="3,8,3,8"
                   Background="Transparent" BorderThickness="0"
                   FontFamily="{StaticResource AppFont}" FontSize="{StaticResource BodyFontSize}"
                   Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" />
        </Border>
      </Grid>

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Row" Style="{StaticResource ItemRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0" Style="{StaticResource CheckCircle}" HorizontalAlignment="Left"
                              IsChecked="{Binding IsDone, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="{Binding Meta}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource RowMeta}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Overdue}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="3" Margin="8,0,0,0" Click="OnRemoveRow">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                      <Setter Property="Opacity" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                          <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <Viewbox Width="13" Height="13">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource TrashGlyph}" Fill="{DynamicResource TextSecondary}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel HorizontalAlignment="Center" Margin="0,120,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <Image Source="{StaticResource AlfredCryingIcon}" Width="80" Height="80" Opacity="0.4" />
        <TextBlock Text="Nothing to remember. Lucky you."
                   Margin="0,14,0,0" HorizontalAlignment="Center"
                   FontFamily="{StaticResource AppFont}" FontSize="14"
                   Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
