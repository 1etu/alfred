<UserControl x:Class="Alfred.App.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">

      <TextBlock Text="Trash" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,10,0,26" />

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource ItemRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource RowMeta}" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="16,0,16,0" Text="{Binding Remaining}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource RowMeta}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpiring}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Overdue}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="2" Style="{StaticResource RowActionButton}" ToolTip="Restore" Click="OnRestore">
                  <Viewbox Width="15" Height="15">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource RestoreGlyph}" Fill="{DynamicResource MoneyIn}" />
                    </Canvas>
                  </Viewbox>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource RowActionButton}" ToolTip="Delete forever" Click="OnForget">
                  <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource TrashGlyph}" Fill="{DynamicResource Overdue}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel HorizontalAlignment="Center" Margin="0,120,0,0"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <Image Source="{StaticResource TrashIcon}" Width="72" Height="72" Opacity="0.28" />
        <TextBlock Text="Nothing deleted. Spotless."
                   Margin="0,18,0,0" HorizontalAlignment="Center"
                   FontFamily="{StaticResource AppFont}" FontSize="14"
                   Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
