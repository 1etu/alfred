<UserControl x:Class="Alfred.App.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls;assembly=Alfred.UIKit">
  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">

      <StackPanel Orientation="Horizontal" Margin="0,44,0,16">
        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,3,10,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource BigTitle}" />
      </StackPanel>

      <controls:QuickBar x:Name="Bar"
                         TitlePlaceholder="{DynamicResource Loc.Plans.Add}"
                         Submitted="OnQuickAdd"
                         Margin="0,0,0,20" />

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="10" Background="{DynamicResource CardBackground}" Margin="0,0,0,8" Padding="4">
              <StackPanel>
                <Border x:Name="Row" Style="{StaticResource ItemRow}" MouseLeftButtonUp="OnRowClick" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                      <Ellipse Stroke="{DynamicResource CheckRing}" StrokeThickness="2" />
                      <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent}">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Progress}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                      <TextBlock Text="{Binding Meta}" Style="{StaticResource RowMeta}" Margin="0,1,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="OnRemoveRow" AutomationProperties.Name="{DynamicResource Loc.Trash.Forget}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                              <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                      <Viewbox Width="13" Height="13">
                        <Canvas Width="24" Height="24">
                          <Path Data="{StaticResource TrashGlyph}" Fill="{DynamicResource TextSecondary}" />
                        </Canvas>
                      </Viewbox>
                    </Button>

                    <Viewbox Grid.Column="3" Width="12" Height="12" Margin="6,0,4,0">
                      <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource ChevronRightGlyph}" Fill="{DynamicResource TextSecondary}" />
                      </Canvas>
                    </Viewbox>
                  </Grid>
                </Border>

                <StackPanel Margin="14,2,14,10"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="30">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ToggleButton Style="{StaticResource CheckCircle}" Width="17" Height="17"
                                        HorizontalAlignment="Left"
                                        IsChecked="{Binding IsDone, Mode=TwoWay}" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                                <Setter Property="FontWeight" Value="Regular" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <controls:SmartInput Margin="0,6,0,0"
                                       Placeholder="{DynamicResource Loc.Plans.AddStep}"
                                       Submitted="OnAddStep" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{DynamicResource Loc.Agenda.Empty}"
                 Style="{StaticResource RowMeta}"
                 Margin="12,10,0,0"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
