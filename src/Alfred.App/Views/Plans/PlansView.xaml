<UserControl x:Class="Alfred.App.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls;assembly=Alfred.UIKit">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">
      <StackPanel Orientation="Horizontal" Margin="0,44,0,14">
        <Image Source="{StaticResource PlansIcon}" Width="24" Height="24" Margin="0,3,10,0" VerticalAlignment="Center" />
        <TextBlock Text="Plans" Style="{StaticResource BigTitle}" />
      </StackPanel>

      <controls:QuickBar x:Name="Bar"
                         Margin="0,0,0,22"
                         TitlePlaceholder="Plan something…"
                         Submitted="OnQuickAdd" />

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="10" Background="{DynamicResource CardBackground}" Margin="0,0,0,8" Padding="4">
              <StackPanel>
                <Border x:Name="Row" Style="{StaticResource ItemRow}" MouseLeftButtonUp="OnRowClick" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                      <TextBlock Text="{Binding Meta}" Style="{StaticResource RowMeta}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="OnRemoveRow">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                          <Setter Property="Opacity" Value="0" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                              <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                      <Viewbox Width="13" Height="13">
                        <Canvas Width="24" Height="24">
                          <Path Data="{StaticResource TrashGlyph}" Fill="{DynamicResource TextSecondary}" />
                        </Canvas>
                      </Viewbox>
                    </Button>
                    <Viewbox Grid.Column="2" Width="12" Height="12" Margin="6,0,4,0">
                      <Viewbox.RenderTransform>
                        <RotateTransform x:Name="ChevronSpin" CenterX="6" CenterY="6" />
                      </Viewbox.RenderTransform>
                      <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource ChevronRightGlyph}" Fill="{DynamicResource TextSecondary}" />
                      </Canvas>
                    </Viewbox>
                  </Grid>
                </Border>

                <StackPanel Margin="14,2,14,10"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="30">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ToggleButton Style="{StaticResource CheckCircle}" Width="17" Height="17"
                                        HorizontalAlignment="Left"
                                        IsChecked="{Binding IsDone, Mode=TwoWay}" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                                <Setter Property="FontWeight" Value="Regular" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <controls:SmartInput Margin="0,6,0,0" Placeholder="Add a step…" Submitted="OnAddStep" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel HorizontalAlignment="Center" Margin="0,120,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <Image Source="{StaticResource AlfredCryingIcon}" Width="80" Height="80" Opacity="0.4" />
        <TextBlock Text="No plans. Even butlers dream."
                   Margin="0,14,0,0" HorizontalAlignment="Center"
                   FontFamily="{StaticResource AppFont}" FontSize="14"
                   Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
