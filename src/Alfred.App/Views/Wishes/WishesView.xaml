<UserControl x:Class="Alfred.App.Views.WishesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls;assembly=Alfred.UIKit">
  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">

      <StackPanel Orientation="Horizontal" Margin="0,44,0,4">
        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,3,10,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource BigTitle}" />
      </StackPanel>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="34,0,0,18" />

      <controls:QuickBar x:Name="Bar"
                         TitlePlaceholder="{DynamicResource Loc.Capture.Placeholder.Wish}"
                         ParseDate="False"
                         ParseAmount="True"
                         Submitted="OnQuickAdd"
                         Margin="0,0,0,18" />

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Row" Style="{StaticResource ItemRow}" MinHeight="42">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Style="{StaticResource CheckCircle}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsAcquired, Mode=TwoWay}" />

                <Border Grid.Column="1"
                        Width="22" Height="22" CornerRadius="6"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SheetHover}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding BrandSlug}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Image Source="{Binding BrandSlug, Converter={StaticResource BrandTileImage}}" Width="13" Height="13" />
                </Border>

                <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                          <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="3" Text="{Binding Price}" Margin="24,0,4,0"
                           Style="{StaticResource RowAmount}" VerticalAlignment="Center" />

                <Button Grid.Column="4" Click="OnRemoveRow" AutomationProperties.Name="{DynamicResource Loc.Trash.Forget}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                          <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <Viewbox Width="12" Height="12">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource TrashGlyph}" Fill="{DynamicResource TextSecondary}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{DynamicResource Loc.Agenda.Empty}"
                 Style="{StaticResource RowMeta}"
                 Margin="12,10,0,0"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
