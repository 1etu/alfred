<UserControl x:Class="Alfred.App.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls;assembly=Alfred.UIKit">
  <ScrollViewer Style="{StaticResource PageRoot}" HorizontalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageBody}">

      <StackPanel Orientation="Horizontal" Margin="0,44,0,20">
        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,3,10,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource BigTitle}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Columns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="248"
                    Margin="0,0,14,0"
                    CornerRadius="10"
                    Background="{DynamicResource CardBackground}"
                    Padding="10"
                    AllowDrop="True"
                    Drop="OnDrop"
                    DragOver="OnDragOver">
              <StackPanel>
                <Grid Margin="4,0,4,10">
                  <TextBlock Text="{Binding Title}"
                             FontFamily="{StaticResource AppFontSmall}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Text="{Binding Cards.Count}"
                             HorizontalAlignment="Right"
                             FontFamily="{StaticResource AppFontSmall}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondary}"
                             Opacity="0.7" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Cards}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Card"
                              CornerRadius="7"
                              Padding="10,9,10,10"
                              Margin="0,0,0,7"
                              Cursor="Hand"
                              MouseMove="OnCardMouseMove">
                        <Border.Background>
                          <Binding Path="TintKey" Converter="{StaticResource BrushLookup}" />
                        </Border.Background>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Title}"
                                     FontFamily="{StaticResource AppFont}"
                                     FontSize="12.5"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource TextPrimary}"
                                     TextWrapping="Wrap" />
                          <Button Grid.Column="1" Click="OnRemoveCard" Width="18" Height="18"
                                  VerticalAlignment="Top" Margin="6,0,0,0" Focusable="False" Cursor="Hand"
                                  AutomationProperties.Name="{DynamicResource Loc.Trash.Forget}">
                            <Button.Style>
                              <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Template">
                                  <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                      <Grid Background="Transparent">
                                        <Path Data="M0,0 L6,6 M6,0 L0,6"
                                              Stroke="{DynamicResource TextSecondary}"
                                              StrokeThickness="1.4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                      </Grid>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:SmartInput Placeholder="{DynamicResource Loc.Board.Add}" Submitted="OnAddCard" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
