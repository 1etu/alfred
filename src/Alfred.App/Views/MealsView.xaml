<UserControl x:Class="Alfred.App.Views.MealsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.App.Controls">
  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">
      <StackPanel Orientation="Horizontal" Margin="0,44,0,14">
        <Image Source="{StaticResource MealsIcon}" Width="24" Height="24" Margin="0,3,10,0" VerticalAlignment="Center" />
        <TextBlock Text="Meals" Style="{StaticResource BigTitle}" />
      </StackPanel>
      <TextBlock Text="{Binding SelectedDayLabel}" Style="{StaticResource PageSubtitle}" Margin="0,10,0,28" />

      <ItemsControl ItemsSource="{Binding Week}" Margin="0,0,0,18">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton GroupName="MealDay" IsChecked="{Binding IsSelected, Mode=TwoWay}" Focusable="False" Cursor="Hand">
              <RadioButton.Template>
                <ControlTemplate TargetType="RadioButton">
                  <Border x:Name="Chip" CornerRadius="9" Width="46" Height="54" Margin="0,0,7,0" Background="Transparent">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"
                                 FontFamily="{StaticResource AppFontSmall}" FontSize="10.5"
                                 Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,2,0,0"
                                 FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SidebarRowHover}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SidebarRowSelected}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </RadioButton.Template>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="{Binding Title}" Style="{StaticResource DayHeader}" Margin="4,0,0,6" />
              <ItemsControl ItemsSource="{Binding Meals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Row" Style="{StaticResource ItemRow}" MinHeight="34">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="26" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource CheckCircle}" Width="17" Height="17"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding IsEaten, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEaten}" Value="True">
                                  <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2" Click="OnRemoveRow">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                              <Setter Property="Opacity" Value="0" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                                  <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Viewbox Width="12" Height="12">
                            <Canvas Width="24" Height="24">
                              <Path Data="{StaticResource TrashGlyph}" Fill="{DynamicResource TextSecondary}" />
                            </Canvas>
                          </Viewbox>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <controls:SmartInput Placeholder="Add a meal…" Submitted="OnAddMeal" Margin="0,4,0,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
