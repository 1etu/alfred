<UserControl x:Class="Alfred.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="520" HorizontalAlignment="Left" Margin="40,36,40,40">

      <TextBlock Text="Settings"
                 FontFamily="{StaticResource AppFontDisplay}"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimary}"
                 Margin="2,0,0,24" />

      <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionTitle}" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>

          <Grid Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="Theme" Style="{StaticResource SettingsRowLabel}" />
              <TextBlock Text="System follows your Windows setting." Style="{StaticResource SettingsRowCaption}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" Content="System" GroupName="Theme"
                             IsChecked="{Binding Settings.IsSystemTheme, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Segment}" Content="Light" GroupName="Theme"
                             IsChecked="{Binding Settings.IsLightTheme, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Segment}" Content="Dark" GroupName="Theme"
                             IsChecked="{Binding Settings.IsDarkTheme, Mode=TwoWay}" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Height="1" Background="{DynamicResource Hairline}" Margin="16,0,0,0" />

          <Grid Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="Glass background" Style="{StaticResource SettingsRowLabel}" />
              <TextBlock Text="Uses the native Windows acrylic backdrop. Costs a little GPU and softens text edges."
                         Style="{StaticResource SettingsRowCaption}" />
            </StackPanel>
            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center"
                          IsChecked="{Binding Settings.IsGlassEnabled, Mode=TwoWay}" />
          </Grid>

        </StackPanel>
      </Border>

      <TextBlock Text="Sidebar" Style="{StaticResource SettingsSectionTitle}" Margin="2,24,0,8" />
      <Border Style="{StaticResource SettingsCard}">
        <Grid Margin="16,14,16,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="Show counts" Style="{StaticResource SettingsRowLabel}" />
            <TextBlock Text="Numbers beside each item for anything needing attention."
                       Style="{StaticResource SettingsRowCaption}" />
          </StackPanel>
          <ToggleButton Grid.Column="1"
                        Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Settings.ShowCounts, Mode=TwoWay}" />
        </Grid>
      </Border>

      <TextBlock Text="About" Style="{StaticResource SettingsSectionTitle}" Margin="2,24,0,8" />
      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <Grid Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Version" Style="{StaticResource SettingsRowLabel}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Settings.Version}"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource AppFontSmall}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" />
          </Grid>

          <Border Height="1" Background="{DynamicResource Hairline}" Margin="16,0,0,0" />

          <StackPanel Margin="16,14,16,14">
            <TextBlock Text="Preferences file" Style="{StaticResource SettingsRowLabel}" />
            <TextBlock Text="{Binding Settings.PreferencesPath}" Style="{StaticResource SettingsRowCaption}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
