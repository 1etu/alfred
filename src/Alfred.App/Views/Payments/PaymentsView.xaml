<UserControl x:Class="Alfred.App.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Alfred.UIKit.Controls;assembly=Alfred.UIKit">
  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">

      <StackPanel Orientation="Horizontal" Margin="0,44,0,4">
        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,3,10,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource BigTitle}" />
      </StackPanel>
      <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" Margin="34,0,0,20" />

      <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Loc.Filter.All}"
                       GroupName="PayFilter" IsChecked="{Binding IsAll, Mode=TwoWay}" />
          <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Loc.Filter.Out}"
                       GroupName="PayFilter" IsChecked="{Binding IsOut, Mode=TwoWay}" />
          <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Loc.Filter.Recurring}"
                       GroupName="PayFilter" IsChecked="{Binding IsRecurring, Mode=TwoWay}" />
          <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Loc.Filter.In}"
                       GroupName="PayFilter" IsChecked="{Binding IsIn, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <controls:QuickBar x:Name="Bar"
                         TitlePlaceholder="{DynamicResource Loc.Capture.Placeholder.Expense}"
                         ParseAmount="True"
                         Submitted="OnQuickAdd" />

      <StackPanel Orientation="Horizontal" Margin="2,10,0,20">
        <Border Style="{StaticResource SegmentGroup}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="KindExpense" Style="{StaticResource Segment}"
                         Content="{DynamicResource Loc.Capture.Kind.Expense}" GroupName="Kind" IsChecked="True" />
            <RadioButton x:Name="KindPayment" Style="{StaticResource Segment}"
                         Content="{DynamicResource Loc.Capture.Kind.Payment}" GroupName="Kind" />
            <RadioButton x:Name="KindIncome" Style="{StaticResource Segment}"
                         Content="{DynamicResource Loc.Capture.Kind.Income}" GroupName="Kind" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SegmentGroup}" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="CadenceOnce" Style="{StaticResource Segment}"
                         Content="{DynamicResource Loc.Cadence.Once}" GroupName="Cadence" IsChecked="True" />
            <RadioButton x:Name="CadenceWeekly" Style="{StaticResource Segment}"
                         Content="{DynamicResource Loc.Cadence.Weekly}" GroupName="Cadence" />
            <RadioButton x:Name="CadenceMonthly" Style="{StaticResource Segment}"
                         Content="{DynamicResource Loc.Cadence.Monthly}" GroupName="Cadence" />
            <RadioButton x:Name="CadenceYearly" Style="{StaticResource Segment}"
                         Content="{DynamicResource Loc.Cadence.Yearly}" GroupName="Cadence" />
          </StackPanel>
        </Border>
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Row" Style="{StaticResource ItemRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{DynamicResource CardBackground}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding BrandSlug}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Image Source="{Binding BrandSlug, Converter={StaticResource BrandTileImage}}" Width="14" Height="14" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource RowMeta}" Margin="0,1,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="2" Margin="14,0,4,0" Text="{Binding Amount}" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource RowAmount}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIncome}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource MoneyIn}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="3" Click="OnRemoveRow" AutomationProperties.Name="{DynamicResource Loc.Trash.Forget}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                          <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <Viewbox Width="13" Height="13">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource TrashGlyph}" Fill="{DynamicResource TextSecondary}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{DynamicResource Loc.Agenda.Empty}"
                 Style="{StaticResource RowMeta}"
                 Margin="12,10,0,0"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
