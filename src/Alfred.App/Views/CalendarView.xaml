<UserControl x:Class="Alfred.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource PageRoot}">
    <StackPanel Style="{StaticResource PageBody}">
      <Grid Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{Binding MonthTitle}" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Everything with a date, in one place" Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Style="{StaticResource IconButton}" Click="OnPrevious">
            <Viewbox Width="13" Height="13">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource ChevronLeftGlyph}" Fill="{DynamicResource TextSecondary}" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="OnNext">
            <Viewbox Width="13" Height="13">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource ChevronRightGlyph}" Fill="{DynamicResource TextSecondary}" />
              </Canvas>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding WeekdayNames}" Margin="0,0,0,4">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" Columns="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" HorizontalAlignment="Center"
                       FontFamily="{StaticResource AppFontSmall}" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" Opacity="0.7" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding Cells}" Margin="0,0,0,10">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="6" Columns="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton GroupName="CalendarDay" IsChecked="{Binding IsSelected, Mode=TwoWay}" Focusable="False" Cursor="Hand">
              <RadioButton.Template>
                <ControlTemplate TargetType="RadioButton">
                  <Border x:Name="Cell" CornerRadius="8" Height="52" Margin="1" Background="Transparent">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="Number" Text="{Binding Number}" HorizontalAlignment="Center"
                                 FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Medium"
                                 Foreground="{DynamicResource TextPrimary}" />
                      <Ellipse x:Name="Dot" Width="4" Height="4" Margin="0,4,0,0"
                               Fill="{DynamicResource TextSecondary}" Opacity="0" />
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                      <Setter TargetName="Number" Property="Opacity" Value="0.3" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                      <Setter TargetName="Dot" Property="Opacity" Value="0.8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                      <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource CheckFill}" />
                      <Setter TargetName="Number" Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SidebarRowHover}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SidebarRowSelected}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </RadioButton.Template>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource DayHeader}" />
      <ItemsControl ItemsSource="{Binding DayItems}" />
      <TextBlock Text="Nothing on this day."
                 Margin="4,4,0,0"
                 FontFamily="{StaticResource AppFontSmall}" FontSize="12"
                 Foreground="{DynamicResource TextSecondary}"
                 Visibility="{Binding DayIsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
