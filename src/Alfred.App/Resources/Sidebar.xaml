<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="SidebarList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ItemContainerStyle" Value="{DynamicResource SidebarRow}" />
  </Style>

  <Style x:Key="SidebarRow" TargetType="ListBoxItem">
    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    <Setter Property="Height" Value="{StaticResource SidebarRowHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Pill"
                  Background="Transparent"
                  CornerRadius="7"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SidebarRowHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SidebarRowSelected}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="SidebarRowContent">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Image Grid.Column="0"
             Source="{Binding Icon}"
             Width="{StaticResource SidebarIconSize}"
             Height="{StaticResource SidebarIconSize}"
             Margin="8,0,0,0"
             VerticalAlignment="Center" />

      <TextBlock Grid.Column="1"
                 Text="{Binding Title}"
                 Margin="10,0,8,0"
                 VerticalAlignment="Center"
                 FontFamily="{StaticResource AppFont}"
                 FontSize="{StaticResource BodyFontSize}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource SidebarText}"
                 TextTrimming="CharacterEllipsis" />

      <TextBlock x:Name="Badge"
                 Grid.Column="2"
                 Text="{Binding Count}"
                 Margin="0,0,10,0"
                 VerticalAlignment="Center"
                 FontFamily="{StaticResource AppFontSmall}"
                 FontSize="{StaticResource BadgeFontSize}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource SidebarBadge}" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Count}" Value="0">
        <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding DataContext.Settings.ShowCounts, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
        <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource SidebarBadgeSelected}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <Style x:Key="SidebarFooterRow" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource SidebarRowHeight}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Pill" Background="Transparent" CornerRadius="7" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SidebarRowHover}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SidebarRowSelected}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SidebarGroup" TargetType="GroupItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupItem">
          <ItemsPresenter Margin="{StaticResource SidebarGroupMargin}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
