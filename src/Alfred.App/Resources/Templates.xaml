<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Alfred.App.ViewModels"
                    xmlns:suggest="clr-namespace:Alfred.App.Suggest">

  <suggest:BrandTileImageConverter x:Key="BrandTileImage" />
  <suggest:IsNotNullConverter x:Key="IsNotNull" />
  <suggest:GlyphLookupConverter x:Key="GlyphLookup" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <DataTemplate DataType="{x:Type vm:AgendaViewModel+DayHeaderRow}">
    <StackPanel>
      <TextBlock Text="{Binding Header}" Style="{StaticResource DayHeader}" />
      <Border Style="{StaticResource SectionRule}" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AgendaViewModel+AgendaRow}">
    <Border x:Name="Row" Style="{StaticResource ItemRow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" MaxWidth="620" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" MinWidth="120" />
        </Grid.ColumnDefinitions>

        <ToggleButton Grid.Column="0"
                      Style="{StaticResource CheckCircle}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsDone, Mode=TwoWay}"
                      Visibility="{Binding HasCheck, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Column="1"
                Width="24" Height="24" CornerRadius="6"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackground}">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding BrandSlug}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Image Source="{Binding BrandSlug, Converter={StaticResource BrandTileImage}}" Width="14" Height="14" />
        </Border>

        <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                  <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Column="3" Text="{Binding Meta}" Margin="18,0,0,0"
                   TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource RowMeta}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Overdue}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Column="5" Text="{Binding Amount}" Margin="24,0,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource RowAmount}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsIncome}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource MoneyIn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </DataTemplate>

</ResourceDictionary>
