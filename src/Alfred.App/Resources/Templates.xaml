<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Alfred.App.ViewModels"
                    xmlns:suggest="clr-namespace:Alfred.App.Suggest">

  <suggest:BrandTileImageConverter x:Key="BrandTileImage" />
  <suggest:IsNotNullConverter x:Key="IsNotNull" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <DataTemplate DataType="{x:Type vm:AgendaViewModel+DayHeaderRow}">
    <TextBlock Text="{Binding Header}" Style="{StaticResource DayHeader}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AgendaViewModel+AgendaRow}">
    <Border Style="{StaticResource ItemRow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ToggleButton Grid.Column="0"
                      Style="{StaticResource CheckCircle}"
                      HorizontalAlignment="Left"
                      IsChecked="{Binding IsDone, Mode=TwoWay}"
                      Visibility="{Binding HasCheck, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Column="1"
                Width="22" Height="22" CornerRadius="5"
                Margin="0,0,9,0"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackground}">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding BrandSlug}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Image Source="{Binding BrandSlug, Converter={StaticResource BrandTileImage}}" Width="13" Height="13" />
        </Border>

        <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                  <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="{Binding Meta}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource RowMeta}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Overdue}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Column="4" Margin="14,0,0,0" Text="{Binding Amount}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource RowAmount}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsIncome}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource MoneyIn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </DataTemplate>

</ResourceDictionary>
