<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Alfred.UIKit.Controls;assembly=Alfred.UIKit"
                    xmlns:vm="clr-namespace:Alfred.App.ViewModels">

  <DataTemplate DataType="{x:Type vm:AgendaViewModel+DayHeaderRow}">
    <controls:SectionHeader Title="{Binding Header}" TintKey="{Binding TintKey}" Margin="0,18,0,0" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AgendaViewModel+AgendaRow}">
    <Border x:Name="Row" Style="{StaticResource ItemRow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ToggleButton Grid.Column="0"
                      Style="{StaticResource CheckCircle}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsDone, Mode=TwoWay}"
                      Visibility="{Binding HasCheck, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Column="1"
                Width="22" Height="22" CornerRadius="6"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Background="{DynamicResource SheetHover}">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding BrandSlug}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Image Source="{Binding BrandSlug, Converter={StaticResource BrandTileImage}}" Width="13" Height="13" />
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Meta}" Margin="0,1,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource RowSub}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Overdue}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <TextBlock Grid.Column="3" Text="{Binding Amount}" Margin="24,0,0,0" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource RowAmount}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsIncome}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource MoneyIn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </DataTemplate>

</ResourceDictionary>
